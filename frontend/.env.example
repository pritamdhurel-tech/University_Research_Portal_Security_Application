# Copy this to .env.local and fill in your values
# Never commit .env.local to source control

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8003/api

# hCaptcha site key (get from hcaptcha.com — free tier available)
# Replace the simulated captcha in LoginPage.tsx with the real widget
VITE_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key-here
